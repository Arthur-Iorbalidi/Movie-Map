exports[`Movies Component > matches snapshot when data is loading 1`] = `
<DocumentFragment>
  <section
    class="_movies_page_0bf9b1"
  >
    <div
      class="_wrapper_0bf9b1"
    >
      <form
        class="_search_form_7818f8"
      >
        <div
          class="_form_field_7818f8"
        >
          <input
            class="_query_field_7818f8"
            name="query"
            placeholder="Search..."
            type="text"
          />
          <button
            class="_submit_btn_7818f8"
            type="submit"
          >
            <img
              alt="search"
              src="/src/assets/icons/search.svg"
            />
          </button>
        </div>
        <p
          class="_error_message_7818f8"
        />
      </form>
      <div
        class="_select_wrapper_0e708d"
      >
        <select
          class="_select_0e708d"
          name="sorting"
        >
          <option
            value="0"
          >
            None
          </option>
          <option
            value="1"
          >
            Title ASC
          </option>
          <option
            value="2"
          >
            Title DESC
          </option>
          <option
            value="3"
          >
            Creation date ASC
          </option>
          <option
            value="4"
          >
            Creation date DESC
          </option>
          <option
            value="5"
          >
            Budget ASC
          </option>
          <option
            value="6"
          >
            Budget DESC
          </option>
        </select>
      </div>
      <h2
        class="_header_0bf9b1"
      >
        Movies
      </h2>
      <div
        class="_grid_d73136 _threeColumns_d73136"
      >
        <div
          class="_loadingWrapper_9f3c22"
        >
          <img
            alt="Loader"
            src="/src/assets/icons/loader.svg"
            style="width: 200px; height: 200px;"
          />
        </div>
      </div>
    </div>
  </section>
</DocumentFragment>
`;

